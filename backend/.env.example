# P.R.I.S.M. Backend Configuration

# Model Settings
MODEL_NAME=gemma-4-26B-A4B-it-MXFP4_MOE
MODEL_HOST=localhost
MODEL_PORT=11434
MODEL_BACKEND=ollama  # Options: ollama, llama_cpp
MODEL_PATH=  # Path to GGUF file (required for llama_cpp)

# llama.cpp Settings (only used if MODEL_BACKEND=llama_cpp)
N_CTX=4096
N_GPU_LAYERS=28
N_THREADS=4
VERBOSE=false

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Knowledge Base Settings
KB_ROOT=../knowledge_base
KB_INDEX_TYPE=faiss
KB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
KB_EMBEDDING_DEVICE=cpu

# Verification Settings
VERIFICATION_THRESHOLD=0.75
VERIFICATION_TOP_K=5

# Confidence Calibration
CONFIDENCE_METHOD=conformal
CONFIDENCE_ALPHA=0.1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/backend.log

# CORS Settings (configure for production)
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
